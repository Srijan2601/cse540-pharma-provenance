# Root .env: used by hardhat.config.js and scripts/ (deploy + role setup).
#
#   cp .env.example .env      then fill in values. .env is gitignored; never commit it.
#
# Nothing here is needed for `npm test` or the local network. These values only
# matter for Polygon Amoy (chainId 80002).
# Use a dedicated TESTNET-ONLY wallet. Never put a key that holds real funds here.
# Safer option for the private key: Hardhat's encrypted keystore instead of .env:
#   npx hardhat keystore set DEPLOYER_PRIVATE_KEY

# --- Polygon Amoy ------------------------------------------------------------
# Public endpoint (rate-limited), or a provider URL (Alchemy/Infura/QuickNode).
# Provider URLs contain an API key, so keep them out of git.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# 0x-prefixed private key of the deployer wallet (fund it from the Amoy POL faucet).
DEPLOYER_PRIVATE_KEY=

# --- scripts/deploy.js ---------------------------------------------------------
# Wallet that receives REGULATOR_ROLE + DEFAULT_ADMIN_ROLE. Leave empty to use the deployer.
REGULATOR_ADDRESS=

# --- scripts/grant-roles.js (public addresses only, not keys) --------------------
# One MetaMask wallet per organization (proposal Fig. 1). On localhost these
# default to Hardhat test accounts #1-#4 when left empty.
MANUFACTURER_ADDRESS=
DISTRIBUTOR_ADDRESS=
RETAILER_ADDRESS=
ORACLE_ADDRESS=

# Optional: override the address read from deployments/<network>.json.
REGISTRY_ADDRESS=
